{
  "layer": "top",
  "position": "top",
  "height": 37,
  "modules-left": ["clock#apple", "hyprland/window", "hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["tray", "battery", "network", "clock#control", "clock#spotlight", "clock#time"],

  "clock#apple": { "format": "\uf179", "tooltip-format": "Apple menüsü", "on-click": "tahoe-apple-menu" },
  "clock#spotlight": { "format": "\uf002", "tooltip-format": "Spotlight Araması", "on-click": "rofi -show drun" },
  "clock#control": { "format": "\ue900", "tooltip-format": "Denetim Merkezi", "on-click": "tahoe-cc control" },
  "clock#notif": { "format": "\uf0f3", "tooltip-format": "Bildirim Merkezi", "on-click": "swaync-client -t -sw" },
  "clock#time": { "locale": "tr_TR.utf8", "format": "{:L%a %e %b  %H:%M}", "tooltip-format": "<tt>{calendar}</tt>", "on-click": "swaync-client -t -sw" },
  "hyprland/window": { "format": "{class}", "max-length": 40, "separate-outputs": true, "rewrite": { "": "Finder", "^org\\.tahoe\\.Settings$": "Sistem Ayarları", "^org\\.tahoe\\.ControlCenter$": "Denetim Merkezi", "^kitty$": "Terminal", "^(firefox|zen)$": "Safari", "^org\\.kde\\.dolphin$": "Finder", "^dolphin$": "Finder", "^pavucontrol$": "Ses Denetimi" }, "on-click": "tahoe-app-menu" },
  "hyprland/workspaces": { "format": "{icon}", "format-icons": { "active": "", "default": "" }, "persistent-workspaces": { "*": 4 }, "on-click": "activate" },

  "battery": { "format": "{icon}", "format-charging": "{icon}", "format-plugged": "{icon}", "format-icons": ["\ue901", "\ue902", "\ue903", "\ue904", "\ue905"], "states": { "warning": 25, "critical": 12 }, "tooltip-format": "%{capacity}", "tooltip-format-discharging": "%{capacity}  ·  {timeTo}", "tooltip-format-charging": "%{capacity}  ·  Şarj oluyor", "tooltip-format-full": "%{capacity}  ·  Dolu", "tooltip-format-plugged": "%{capacity}  ·  Dolu", "on-click": "tahoe-cc battery", "on-click-right": "tahoe-settings --pane battery" },
  "network": { "format-wifi": "", "format-ethernet": "", "format-disconnected": "", "tooltip-format": "{essid}  {signalStrength}%", "on-click": "tahoe-cc wifi", "on-click-right": "tahoe-settings --pane wifi" },
  "pulseaudio": { "format": "{icon}", "format-muted": "", "format-icons": { "default": ["","",""] }, "on-click": "tahoe-cc sound", "on-click-right": "tahoe-settings --pane sound", "scroll-step": 5 },
  "tray": { "spacing": 4, "icon-size": 18 }
}
