* { bg: #1e1e24b8; fg: #f5f5f7; sel: #0a84ffff; background-color: transparent; text-color: @fg; }
configuration {
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
    font: "Inter 10.5";
}
window { location: north west; anchor: north west; x-offset: 6px; y-offset: 2px; width: 270px; background-color: @bg; border: 1px; border-color: #ffffff22; border-radius: 10px; }
mainbox { padding: 5px; children: [ message, listview ]; }
message { padding: 4px 10px; }
listview { lines: 16; dynamic: true; spacing: 0px; scrollbar: false; fixed-height: false; }
element { padding: 3px 10px; border-radius: 5px; }
element selected.normal { background-color: @sel; text-color: #ffffff; }
element-text { vertical-align: 0.5; markup: true; }
element normal.normal, element alternate.normal, element normal.urgent, element alternate.urgent, element normal.active, element alternate.active { background-color: transparent; text-color: @fg; }
