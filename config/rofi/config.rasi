configuration {
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
    modes: [drun, run];
    show-icons: true;
    display-drun: "󰍉";
    drun-display-format: "{name}";
    font: "Inter 14";
}

* { bg: #1e1e24b8; fg: #f5f5f7; sel: #ffffff22; background-color: transparent; text-color: @fg; }

window { location: north; anchor: north; y-offset: 18%; width: 640px; background-color: @bg; border: 1px; border-color: #ffffff22; border-radius: 22px; }
mainbox { padding: 14px; spacing: 10px; children: [ inputbar, listview ]; }
inputbar { padding: 12px 16px; background-color: #ffffff14; border-radius: 14px; spacing: 10px; children: [ prompt, entry ]; }
prompt { text-color: #ffffffaa; }
entry { placeholder: "Spotlight Araması"; placeholder-color: #ffffff66; }
listview { lines: 7; columns: 1; fixed-height: false; spacing: 4px; scrollbar: false; border: 0; background-color: transparent; }
element { padding: 10px 12px; border-radius: 12px; spacing: 12px; }
element normal.normal, element alternate.normal, element normal.urgent, element alternate.urgent, element normal.active, element alternate.active { background-color: transparent; text-color: @fg; }
element selected.normal, element selected.urgent, element selected.active { background-color: @sel; text-color: @fg; }
element-icon { size: 28px; background-color: transparent; }
element-text { background-color: transparent; text-color: inherit; }
