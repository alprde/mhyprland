#!/bin/sh
# Düzenleyicisiz ekran görüntüsü: tahoe-shot-save full | region  → Resimler/Ekran Görüntüleri'ne PNG kaydeder + panoya kopyalar.
# Tam çözünürlük (örn. 2560x1440); alan seçerken pencereler pasif solmasın diye görüntü seçimden ÖNCE alınır (tahoe-grab).
D="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Ekran Görüntüleri"; mkdir -p "$D"
F="$D/Ekran-$(date +%Y%m%d-%H%M%S).png"
case "$1" in
  region) tahoe-grab > "$F.ppm" || { rm -f "$F.ppm"; exit 0; } ;;
  *) N="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')"; grim -o "$N" -t ppm "$F.ppm" || exit 1 ;;
esac
python3 -c "import sys; from PIL import Image; Image.open(sys.argv[1]).save(sys.argv[2])" "$F.ppm" "$F" && rm -f "$F.ppm"
wl-copy --type image/png < "$F"
command -v notify-send >/dev/null && notify-send -i "$F" "Ekran görüntüsü kaydedildi" "$(basename "$F")"
