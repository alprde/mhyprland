#!/bin/sh
# Ekran görüntüsü, Swappy düzenleyicisiyle: alanı seç → çiz → Ctrl+C kopyala / Ctrl+S kaydet (Resimler/Ekran Görüntüleri)
D="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Ekran Görüntüleri"; mkdir -p "$D" "$HOME/.config/swappy"
# Swappy yapılandırmadaki klasör yolunu ilk BOŞLUKTA kesiyor → boşluksuz bir sembolik bağ üzerinden kaydettir
L="$HOME/.local/share/tahoe/screenshots"; mkdir -p "$(dirname "$L")"; [ -L "$L" ] || ln -s "$D" "$L"
printf '[Default]\nsave_dir=%s\nsave_filename_format=Ekran-%%Y%%m%%d-%%H%%M%%S.png\nearly_exit=true\n' "$L" > "$HOME/.config/swappy/config"
T="$(mktemp --suffix=.ppm)"; trap 'rm -f "$T"' EXIT
tahoe-grab > "$T" || exit 0
swappy -f "$T"
