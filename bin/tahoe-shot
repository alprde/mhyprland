#!/bin/sh
# Ekran görüntüsü (Xnip gibi): alanı seç → Satty düzenleyicisinde çiz (ok, kutu, yazı, bulanıklaştır) →
#   Enter = panoya kopyala + dosyaya kaydet ve kapat · Esc = vazgeç.   Satty yoksa hyprshot ile doğrudan kaydeder.
D="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Ekran Görüntüleri"; mkdir -p "$D"
if command -v satty >/dev/null 2>&1 && command -v grim >/dev/null 2>&1 && command -v slurp >/dev/null 2>&1; then
  T="$(mktemp --suffix=.ppm)"; trap 'rm -f "$T"' EXIT
  tahoe-grab > "$T" || exit 0                    # Esc ile seçim iptal edilirse çık
  satty --filename "$T" --output-filename "$D/Ekran-%Y%m%d-%H%M%S.png" --copy-command wl-copy \
        --actions-on-enter save-to-clipboard --actions-on-enter save-to-file --actions-on-enter exit --initial-tool arrow
else
  HYPRSHOT_DIR="$D" exec hyprshot -m region
fi
