def traffic_lights(win):
    box = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER); box.add_css_class('tl-box')
    def mk(cls, glyph, cb):
        b = Gtk.Button(); b.add_css_class('tl'); b.add_css_class(cls); b.set_focusable(False)
        b.set_child(Gtk.Label(label=glyph)); b.connect('clicked', lambda *_: cb()); box.append(b)
    mk('tl-close', '×', win.close)
    mk('tl-min', '−', lambda: sh("hyprctl dispatch 'hl.dsp.window.move({ workspace = \"special:minimized\" })'"))
    mk('tl-max', '+', lambda: sh("hyprctl dispatch 'hl.dsp.window.fullscreen()'"))
    return box

def no_native_controls(*bars):
    for b in bars:
        b.set_show_start_title_buttons(False); b.set_show_end_title_buttons(False)

# ───────────────────────── Sistem Ayarları penceresi ─────────────────────────
class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app, pane=None):
        super().__init__(application=app, title='Sistem Ayarları', default_width=1000, default_height=700)
        self.toasts = Adw.ToastOverlay()
        self.split = Adw.NavigationSplitView(); self.split.set_min_sidebar_width(250); self.split.set_max_sidebar_width(300)
        self.toasts.set_child(self.split); self.set_content(self.toasts)
        sb = Adw.ToolbarView(); sh_ = Adw.HeaderBar(); sh_.set_show_title(False); sb.add_top_bar(sh_)
        no_native_controls(sh_); sh_.pack_start(traffic_lights(self))
        self.search = Gtk.SearchEntry(placeholder_text='Ara', margin_start=10, margin_end=10, margin_bottom=6)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); box.append(self.search)
        self.lb = Gtk.ListBox(css_classes=['navigation-sidebar']); self.lb.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.idx = []
        for p in PANES:
            if p is None:
                r = Gtk.ListBoxRow(selectable=False, activatable=False, height_request=14); r.add_css_class('tahoe-sep'); r.sep = True; r.name = ''; self.lb.append(r); self.idx.append(None); continue
            key, name, icon, fn = p
            r = Gtk.ListBoxRow(); r.sep = False; r.key = key; r.name = name
            h = Gtk.Box(spacing=12, margin_top=7, margin_bottom=7, margin_start=8, margin_end=8)
            h.append(Gtk.Image.new_from_icon_name(icon)); h.append(Gtk.Label(label=name, xalign=0)); r.set_child(h)
            self.lb.append(r); self.idx.append(p)
        sc = Gtk.ScrolledWindow(vexpand=True); sc.set_child(self.lb); box.append(sc); sb.set_content(box)
        self.split.set_sidebar(Adw.NavigationPage.new(sb, 'Sistem Ayarları'))
        self.ctb = Adw.ToolbarView(); self.chead = Adw.HeaderBar(); self.ctitle = Adw.WindowTitle(title='', subtitle=''); self.chead.set_title_widget(self.ctitle)
        no_native_controls(self.chead)
        self.ctb.add_top_bar(self.chead)
        self.cpage = Adw.NavigationPage.new(self.ctb, 'Ayarlar'); self.split.set_content(self.cpage)
        self.lb.connect('row-selected', self.on_row)
        self.search.connect('search-changed', lambda e: self.lb.invalidate_filter())
        self.lb.set_filter_func(self.filt)
        self.show_pane(pane or 'wifi')

    def filt(self, row):
        q = self.search.get_text().lower().strip()
        if not q: return True
        return (not row.sep) and q in row.name.lower()

    def on_row(self, lb, row):
        if row is None or row.sep: return
        self.build(row.key)

    def build(self, key):
        for p in PANES:
            if p and p[0] == key:
                self.ctitle.set_title(p[1]); self.cpage.set_title(p[1])
                try: w = p[3]()
                except Exception as e:
                    w = Adw.StatusPage(title='Bu bölüm açılamadı', description=str(e))
                self.ctb.set_content(w); self.split.set_show_content(True); return

    def show_pane(self, key):
        for i, p in enumerate(PANES):
            if p and p[0] == key:
                self.lb.select_row(self.lb.get_row_at_index(i)); return

# ───────────────────────── Denetim Merkezi ─────────────────────────
class PillSlider(Gtk.DrawingArea):
    """macOS Denetim Merkezi kaydırıcısı: beyaz dolgu, yuvarlak dolgunun İÇİNDE sağ ucuna yaslı (en az 1 yuvarlak görünür)."""
    D = 21

    def __init__(self, cb):
        super().__init__()
        self.cb = cb; self.v = 0.0; self._x0 = 0.0
        self.set_content_height(self.D); self.set_hexpand(True); self.set_draw_func(self.draw)
        g = Gtk.GestureDrag(); g.connect('drag-begin', lambda g_, x, y: (setattr(self, '_x0', x), self._set_from_x(x)))
        g.connect('drag-update', lambda g_, dx, dy: self._set_from_x(self._x0 + dx)); self.add_controller(g)

    def set_value(self, v):          # programatik: geri çağırma YOK
        self.v = max(0.0, min(100.0, float(v))); self.queue_draw()

    def get_value(self): return self.v

    def _set_from_x(self, x):
        w = max(1, self.get_width()); d = max(1, self.get_height())
        v = max(0.0, min(100.0, (x - d / 2) / max(1, (w - d)) * 100))
        changed = int(v) != int(self.v); self.v = v; self.queue_draw()
        if changed: self.cb(v)

    @staticmethod
    def _pill(cr, x, y, w, h):
        import math
        r = h / 2
        cr.new_sub_path(); cr.arc(x + w - r, y + r, r, -math.pi / 2, math.pi / 2); cr.arc(x + r, y + r, r, math.pi / 2, 3 * math.pi / 2); cr.close_path()

    def draw(self, area, cr, w, h):
        import math
        d = h; dark = S['dark']; r = d / 2          # yuvarlağın çapı = çubuğun GERÇEK yüksekliği
        self._pill(cr, 0, 0, w, h); cr.set_source_rgba(1, 1, 1, 0.18) if dark else cr.set_source_rgba(0, 0, 0, 0.12); cr.fill()
        fe = d + self.v / 100 * (w - d)                       # dolgunun sağ ucu = yuvarlağın sağ kenarı
        for k in range(6):                                    # yuvarlağın yumuşak gölgesi (çizgi değil)
            cr.arc(fe - r + 0.6, r + 1.2, r + k * 0.7, 0, 2 * math.pi); cr.set_source_rgba(0, 0, 0, 0.055 * (6 - k) / 6 + 0.01); cr.fill()
        self._pill(cr, 0, 0, fe, h); cr.set_source_rgb(1, 1, 1); cr.fill()


def fetch_state():
    """Panelin gösterdiği sistem durumu: paralel sorgular, her biri en çok 2 sn."""
    from concurrent.futures import ThreadPoolExecutor
    q = {'wifi': 'nmcli radio wifi', 'bt': 'bluetoothctl show',
         'ssid': "LC_ALL=C nmcli -t -f ACTIVE,SSID dev wifi list --rescan no | grep '^yes' | head -1 | cut -d: -f2",
         'prof': 'powerprofilesctl get', 'dnd': 'swaync-client -D', 'br': 'brightnessctl -m | cut -d, -f4',
         'vol': 'wpctl get-volume @DEFAULT_AUDIO_SINK@', 'title': 'playerctl metadata title 2>/dev/null',
         'artist': 'playerctl metadata artist 2>/dev/null', 'art': 'playerctl metadata mpris:artUrl 2>/dev/null',
         'pstat': 'playerctl status 2>/dev/null'}
    with ThreadPoolExecutor(10) as ex:
        f = {k: ex.submit(sh, c, 2) for k, c in q.items()}
        return {k: v.result() for k, v in f.items()}


class ControlCenter(Gtk.ApplicationWindow):
    """Bir monitör için önceden kurulmuş (gizli) Denetim Merkezi paneli."""
    def __init__(self, app, daemon, gmon, D):
        super().__init__(application=app, title='Denetim Merkezi', default_width=296, decorated=False, resizable=False)
        self.daemon = daemon; self._upd = False
        self.add_css_class('tahoe-cc-win')
        self.set_child(self.build_ui(D))
        kc = Gtk.EventControllerKey()
        kc.connect('key-pressed', lambda c, kv, kc_, st: (self.daemon.hide(), True)[1] if kv == Gdk.KEY_Escape else False)
        self.add_controller(kc)
        if LS_OK:
            LS = Gtk4LayerShell
            LS.init_for_window(self); LS.set_namespace(self, 'tahoe-cc'); LS.set_layer(self, LS.Layer.OVERLAY)
            LS.set_anchor(self, LS.Edge.TOP, True); LS.set_anchor(self, LS.Edge.RIGHT, True)
            LS.set_margin(self, LS.Edge.TOP, 6); LS.set_margin(self, LS.Edge.RIGHT, 8)
            LS.set_keyboard_mode(self, LS.KeyboardMode.EXCLUSIVE)
            if gmon is not None: LS.set_monitor(self, gmon)

    # ── arayüz ──
    def build_ui(self, D):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        outer.set_size_request(276, -1)

        def circle(icon, active):
            img = Gtk.Image.new_from_icon_name(icon); img.set_pixel_size(14)
            img.set_halign(Gtk.Align.CENTER); img.set_valign(Gtk.Align.CENTER); img.set_hexpand(True); img.set_vexpand(True)
            c = Gtk.Box(); c.add_css_class('cc-circle'); c.set_size_request(26, 26); c.set_valign(Gtk.Align.CENTER)
            c.set_halign(Gtk.Align.START); c.set_hexpand(False); c.append(img)
            if active: c.add_css_class('on')
            return c

        def label_box(title, sub=None):
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1, valign=Gtk.Align.CENTER, hexpand=True)
            t = Gtk.Label(label=title, xalign=0, wrap=True); t.add_css_class('cc-title'); v.append(t)
            s = None
            if sub is not None:
                s = Gtk.Label(label=sub, xalign=0, ellipsize=3, max_width_chars=8); s.add_css_class('cc-sub'); v.append(s)
            return v, s

        def row(icon, title, sub, active):
            b = Gtk.Button(); b.add_css_class('cc-row'); b.set_focusable(False)
            h = Gtk.Box(spacing=8); c = circle(icon, active); v, s = label_box(title, sub)
            h.append(c); h.append(v); b.set_child(h)
            return b, c, s

        # ── bağlantılar ──
        top = Gtk.Box(spacing=10, homogeneous=True)
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0); left.add_css_class('cc-card')
        self.st = {'wifi': False, 'bt': False, 'dnd': False, 'prof': 1}
        wb, self.wc, self.ws = row('network-wireless-symbolic', 'Wi-Fi', '', False)
        bb, self.bc, self.bs = row('bluetooth-active-symbolic', 'Bluetooth', '', False)
        pb, self.pc, self.ps = row('battery-level-60-symbolic', 'Güç Modu', '', False)
        self.profs = ['power-saver', 'balanced', 'performance']; self.pnames = ['Tasarruf', 'Dengeli', 'Performans']
        self.picons = ['battery-level-30-symbolic', 'battery-level-60-symbolic', 'battery-level-100-symbolic']
        wb.connect('clicked', lambda *_: self.open_wifi())
        _ch = Gtk.Image.new_from_icon_name('go-next-symbolic'); _ch.set_pixel_size(14); _ch.set_opacity(0.6); _ch.set_valign(Gtk.Align.CENTER); wb.get_child().append(_ch)
        bb.connect('clicked', lambda *_: self.open_bt())
        _ch2 = Gtk.Image.new_from_icon_name('go-next-symbolic'); _ch2.set_pixel_size(14); _ch2.set_opacity(0.6); _ch2.set_valign(Gtk.Align.CENTER); bb.get_child().append(_ch2)
        pb.connect('clicked', lambda *_: self.prof_cycle())
        for b in (wb, bb, pb): left.append(b)
        top.append(left)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        db = Gtk.Button(); db.add_css_class('cc-card'); db.add_css_class('cc-tilebtn'); db.set_focusable(False); db.set_vexpand(True)
        dh = Gtk.Box(spacing=10); self.dc = circle('weather-clear-night-symbolic', False); dv, _s = label_box('Rahatsız\nEtme'); dh.append(self.dc); dh.append(dv); db.set_child(dh)
        db.connect('clicked', lambda *_: self.dnd_toggle())
        right.append(db)
        small = Gtk.Box(spacing=10, homogeneous=True)
        def tile(icon, title, cb):
            b = Gtk.Button(); b.add_css_class('cc-card'); b.add_css_class('cc-tilebtn'); b.set_focusable(False)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
            im = Gtk.Image.new_from_icon_name(icon); im.set_pixel_size(22)
            t = Gtk.Label(label=title, justify=Gtk.Justification.CENTER, wrap=True); t.add_css_class('cc-tile-t')
            v.append(im); v.append(t); b.set_child(v); b.connect('clicked', lambda *_: cb(b)); return b
        def dark_toggle(b):
            S['dark'] = not S['dark']; save(); (b.add_css_class if S['dark'] else b.remove_css_class)('on'); bg(apply_theme)
        self.dark_tile = tile('night-light-symbolic', 'Koyu\nMod', dark_toggle)
        small.append(self.dark_tile)
        small.append(tile('system-lock-screen-symbolic', 'Ekranı\nKilitle', lambda b: (self.daemon.hide(), bg_run('hyprlock'))))
        right.append(small); top.append(right); outer.append(top)

        # ── kaydırıcılar ──
        def slider_card(title, icon, cb, extra=None):
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); card.add_css_class('cc-card'); card.add_css_class('cc-scard')
            t = Gtk.Label(label=title, xalign=0); t.add_css_class('cc-title'); card.append(t)
            h = Gtk.Box(spacing=9); h.set_size_request(-1, 25); ov = Gtk.Overlay(hexpand=True, valign=Gtk.Align.CENTER)
            sc = PillSlider(lambda v: cb(v))
            ov.set_child(sc)
            ic = Gtk.Image.new_from_icon_name(icon); ic.set_pixel_size(12); ic.set_halign(Gtk.Align.START); ic.set_valign(Gtk.Align.CENTER)
            ic.set_margin_start(6); ic.set_can_target(False); ic.add_css_class('cc-slider-icon'); ov.add_overlay(ic)
            h.append(ov)
            if extra is not None: h.append(extra)
            card.append(h); return card, sc
        card, self.br_scale = slider_card('Ekran', 'display-brightness-symbolic', lambda v: bg_run(f'brightnessctl set {max(1, int(v))}%'))
        outer.append(card)
        outb = Gtk.Button(); outb.add_css_class('cc-circle'); outb.add_css_class('cc-roundbtn'); outb.set_focusable(False); outb.set_size_request(25, 25)
        _oi = Gtk.Image.new_from_icon_name('audio-speakers-symbolic'); _oi.set_pixel_size(13); outb.set_child(_oi); outb.connect('clicked', lambda *_: (self.daemon.hide(), bg_run('tahoe-settings --pane sound')))
        card, self.vol_scale = slider_card('Ses', 'audio-volume-high-symbolic', lambda v: bg_run(f'wpctl set-volume @DEFAULT_AUDIO_SINK@ {int(v)}%'), outb)
        outer.append(card)

        self.np_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.append(self.np_box)
        self.apply_state(D)
        self.stack = Gtk.Stack(); self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT); self.stack.set_transition_duration(160)
        self.stack.set_vhomogeneous(False); self.stack.set_interpolate_size(True); self.stack.set_hexpand(True)
        self.stack.add_named(outer, 'main'); self.stack.add_named(self.build_wifi_view(), 'wifi'); self.stack.add_named(self.build_bt_view(), 'bt')
        root = Gtk.Box(); root.add_css_class('tahoe-cc-box'); root.append(self.stack)
        self.root = root
        return root

    # ───────────── Wi-Fi alt görünümü (macOS: Wi-Fi'ye basınca ağ listesi açılır) ─────────────
    def build_wifi_view(self):
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        head = Gtk.Box(spacing=8)
        back = Gtk.Button(icon_name='go-previous-symbolic'); back.add_css_class('cc-media'); back.set_focusable(False)
        back.connect('clicked', lambda *_: self.show_main())
        title = Gtk.Label(label='Wi-Fi', xalign=0, hexpand=True); title.add_css_class('cc-title-lg')
        self.wspin = Gtk.Spinner()
        self.wsw = Gtk.Switch(valign=Gtk.Align.CENTER); self.wsw.connect('notify::active', self.on_wifi_switch)
        for w in (back, title, self.wspin, self.wsw): head.append(w)
        v.append(head)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); card.add_css_class('cc-card')
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_propagate_natural_height(True); sc.set_max_content_height(320); sc.set_min_content_height(80)
        self.wlist = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        sc.set_child(self.wlist); card.append(sc); v.append(card)

        # Parola isteği (satır içi)
        self.pwbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); self.pwbox.add_css_class('cc-card'); self.pwbox.set_visible(False)
        self.pwlabel = Gtk.Label(label='', xalign=0, wrap=True); self.pwlabel.add_css_class('cc-title'); self.pwbox.append(self.pwlabel)
        pr = Gtk.Box(spacing=8)
        self.pwentry = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True, placeholder_text='Parola')
        self.pwbtn = Gtk.Button(label='Bağlan'); self.pwbtn.add_css_class('suggested-action')
        self.pwentry.connect('activate', lambda *_: self.submit_pw()); self.pwbtn.connect('clicked', lambda *_: self.submit_pw())
        pr.append(self.pwentry); pr.append(self.pwbtn); self.pwbox.append(pr); v.append(self.pwbox)
        self.pw_ssid = None

        foot = Gtk.Button(label='Wi-Fi Ayarları…'); foot.add_css_class('cc-card'); foot.add_css_class('cc-tilebtn'); foot.set_focusable(False)
        foot.connect('clicked', lambda *_: (self.daemon.hide(), bg_run('tahoe-settings --pane wifi')))
        v.append(foot)
        self._scan_id = 0
        return v

    def show_main(self):
        self.pwbox.set_visible(False); self.pw_ssid = None; self.wspin.stop(); self.bspin.stop(); self._bscan_id += 1
        self.stack.set_visible_child_name('main')

    def reset_view(self):
        self.stack.set_visible_child_full('main', Gtk.StackTransitionType.NONE)
        self.pwbox.set_visible(False); self.pw_ssid = None; self.wspin.stop(); self.pwentry.set_text(''); self.bspin.stop(); self._bscan_id += 1

    def open_wifi(self):
        """Wi-Fi'ye basılınca: listeyi hemen önbellekten göster, taramayı BU anda başlat."""
        self._upd = True; self.wsw.set_active(self.st['wifi']); self._upd = False
        self.stack.set_visible_child_name('wifi')
        self.refresh_wifi_list()
        if self.st['wifi']:
            self.wspin.start(); self._scan_id += 1; sid = self._scan_id
            def scan():
                sh('nmcli dev wifi rescan', 6); time.sleep(2.5); return sid
            def done(s):
                if s == self._scan_id: self.wspin.stop(); self.refresh_wifi_list()
            bg(scan, done)

    def on_wifi_switch(self, sw, _):
        if self._upd: return
        on = sw.get_active(); self.st['wifi'] = on; self._on(self.wc, on); self.ws.set_text('Açılıyor…' if on else 'Kapalı')
        if not on: self.fill_wifi_list('', off=True)
        def work():
            sh(f'nmcli radio wifi {"on" if on else "off"}')
            if on: time.sleep(2.0); sh('nmcli dev wifi rescan', 6); time.sleep(2.5)
            return on
        if on: self.wspin.start()
        def done(_r):
            self.wspin.stop(); self.refresh_wifi_list()
            self.ws.set_text(self.cur_ssid() or ('Bağlı değil' if self.st['wifi'] else 'Kapalı'))
        bg(work, done)

    @staticmethod
    def cur_ssid():
        return sh("LC_ALL=C nmcli -t -f ACTIVE,SSID dev wifi list --rescan no | grep '^yes' | head -1 | cut -d: -f2")

    def refresh_wifi_list(self):
        if not self.st['wifi']: self.fill_wifi_list('', off=True); return
        bg(lambda: sh('LC_ALL=C nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list --rescan no', 8), lambda out: self.fill_wifi_list(out or ''))

    def fill_wifi_list(self, out, off=False):
        while True:
            c = self.wlist.get_first_child()
            if c is None: break
            self.wlist.remove(c)
        if off:
            l = Gtk.Label(label='Wi-Fi kapalı', margin_top=24, margin_bottom=24); l.add_css_class('cc-sub'); self.wlist.append(l); return
        seen = {}
        for ln in out.split('\n'):
            f = re.split(r'(?<!\\):', ln)
            if len(f) < 4 or not f[1]: continue
            ssid = f[1].replace('\\:', ':')
            cur = {'inuse': f[0] == '*', 'sig': int(f[2] or 0), 'sec': f[3].strip()}
            if ssid not in seen or cur['inuse'] or (not seen[ssid]['inuse'] and seen[ssid]['sig'] < cur['sig']): seen[ssid] = cur
        if not seen:
            l = Gtk.Label(label='Ağ bulunamadı', margin_top=24, margin_bottom=24); l.add_css_class('cc-sub'); self.wlist.append(l); return
        for ssid, c in sorted(seen.items(), key=lambda kv: (not kv[1]['inuse'], -kv[1]['sig']))[:30]:
            b = Gtk.Button(); b.add_css_class('cc-row'); b.set_focusable(False)
            h = Gtk.Box(spacing=10, margin_start=4, margin_end=4)
            chk = Gtk.Image.new_from_icon_name('object-select-symbolic' if c['inuse'] else 'image-missing'); chk.set_pixel_size(16)
            if not c['inuse']: chk.set_opacity(0)
            lab = Gtk.Label(label=ssid, xalign=0, hexpand=True, ellipsize=3); lab.add_css_class('cc-title')
            h.append(chk); h.append(lab)
            if c['sec'] and c['sec'] != '--':
                lk = Gtk.Image.new_from_icon_name('channel-secure-symbolic'); lk.set_pixel_size(14); lk.set_opacity(0.7); h.append(lk)
            lvl = 'excellent' if c['sig'] > 75 else 'good' if c['sig'] > 50 else 'ok' if c['sig'] > 25 else 'weak'
            sg = Gtk.Image.new_from_icon_name(f'network-wireless-signal-{lvl}-symbolic'); sg.set_pixel_size(16); h.append(sg)
            b.set_child(h)
            if not c['inuse']: b.connect('clicked', lambda _b, s=ssid, sec=c['sec']: self.connect_ssid(s, sec))
            self.wlist.append(b)

    def connect_ssid(self, ssid, sec):
        self.pwbox.set_visible(False); self.wspin.start()
        q = ssid.replace("'", "'\\''")
        def work(): return sh(f"LC_ALL=C nmcli dev wifi connect '{q}'", 40)
        def done(out):
            self.wspin.stop(); out = out or ''
            if 'successfully' in out.lower():
                self.ws.set_text(ssid); self.refresh_wifi_list()
            elif sec and sec != '--' and ('secrets' in out.lower() or 'password' in out.lower() or 'no key' in out.lower() or not out):
                self.ask_pw(ssid)
            else:
                self.ask_pw(ssid, err=out.split('\n')[-1][:80] if out else 'Bağlanılamadı') if (sec and sec != '--') else self.refresh_wifi_list()
        bg(work, done)

    def ask_pw(self, ssid, err=None):
        self.pw_ssid = ssid; self.pwlabel.set_text(f'“{ssid}” için parola' + (f'\n{err}' if err else ''))
        self.pwentry.set_text(''); self.pwbox.set_visible(True); self.pwentry.grab_focus()

    def submit_pw(self):
        if not self.pw_ssid: return
        ssid, pw = self.pw_ssid, self.pwentry.get_text()
        if not pw: return
        q = ssid.replace("'", "'\\''"); pq = pw.replace("'", "'\\''")
        self.wspin.start(); self.pwbtn.set_sensitive(False)
        def done(out):
            self.wspin.stop(); self.pwbtn.set_sensitive(True)
            if out and 'successfully' in out.lower():
                self.pwbox.set_visible(False); self.pw_ssid = None; self.ws.set_text(ssid); self.refresh_wifi_list()
            else:
                self.ask_pw(ssid, err=(out.split('\n')[-1][:80] if out else 'Bağlanılamadı'))
        bg(lambda: sh(f"LC_ALL=C nmcli dev wifi connect '{q}' password '{pq}'", 40), done)

    # ───────────── Bluetooth alt görünümü ─────────────
    def build_bt_view(self):
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        head = Gtk.Box(spacing=8)
        back = Gtk.Button(icon_name='go-previous-symbolic'); back.add_css_class('cc-media'); back.set_focusable(False)
        back.connect('clicked', lambda *_: self.show_main())
        title = Gtk.Label(label='Bluetooth', xalign=0, hexpand=True); title.add_css_class('cc-title-lg')
        self.bspin = Gtk.Spinner()
        self.bsw = Gtk.Switch(valign=Gtk.Align.CENTER); self.bsw.connect('notify::active', self.on_bt_switch)
        for w in (back, title, self.bspin, self.bsw): head.append(w)
        v.append(head)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); card.add_css_class('cc-card')
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_propagate_natural_height(True); sc.set_max_content_height(320); sc.set_min_content_height(80)
        self.blist = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        sc.set_child(self.blist); card.append(sc); v.append(card)
        foot = Gtk.Button(label='Bluetooth Ayarları…'); foot.add_css_class('cc-card'); foot.add_css_class('cc-tilebtn'); foot.set_focusable(False)
        foot.connect('clicked', lambda *_: (self.daemon.hide(), bg_run('tahoe-settings --pane bluetooth')))
        v.append(foot)
        self._bscan_id = 0
        return v

    def open_bt(self):
        """Bluetooth'a basılınca: kayıtlı cihazları hemen göster, taramayı BU anda başlat."""
        self._upd = True; self.bsw.set_active(self.st['bt']); self._upd = False
        self.stack.set_visible_child_name('bt')
        self.refresh_bt_list()
        if self.st['bt']: self.scan_bt()

    def scan_bt(self):
        self._bscan_id += 1; sid = self._bscan_id; self.bspin.start()
        def scan():
            sh('bluetoothctl --timeout 9 scan on', 14); return sid
        def done(s):
            if s == self._bscan_id: self.bspin.stop(); self.refresh_bt_list()
        bg(scan, done)
        for ms in (2500, 5500):   # tarama sürerken liste canlı güncellensin
            GLib.timeout_add(ms, lambda sid=sid: (self.refresh_bt_list() if sid == self._bscan_id else None, False)[1])

    def on_bt_switch(self, sw, _):
        if self._upd: return
        on = sw.get_active(); self.st['bt'] = on; self._on(self.bc, on); self.bs.set_text('Açık' if on else 'Kapalı')
        if not on: self._bscan_id += 1; self.bspin.stop(); self.fill_bt_list([], off=True)
        def work():
            if on: sh('rfkill unblock bluetooth')
            sh(f'bluetoothctl power {"on" if on else "off"}', 6)
            if on: time.sleep(1.0)
            return on
        def done(_r):
            if self.st['bt']: self.refresh_bt_list(); self.scan_bt()
        bg(work, done)

    def refresh_bt_list(self):
        if not self.st['bt']: self.fill_bt_list([], off=True); return
        def work():
            from concurrent.futures import ThreadPoolExecutor
            macs = re.findall(r'Device (\S+) (.*)', sh('bluetoothctl devices', 4))
            with ThreadPoolExecutor(8) as ex: infos = list(ex.map(lambda m: sh(f'bluetoothctl info {m[0]}', 3), macs))
            devs = []
            for (mac, name), info in zip(macs, infos):
                g = lambda k: (re.search(rf'^\s*{k}: (.*)$', info, re.M) or [None, ''])[1].strip()
                devs.append({'mac': mac, 'name': g('Alias') or name, 'icon': g('Icon'), 'paired': g('Paired') == 'yes', 'connected': g('Connected') == 'yes'})
            return devs
        bg(work, lambda d: self.fill_bt_list(d or []))

    def fill_bt_list(self, devs, off=False):
        while True:
            c = self.blist.get_first_child()
            if c is None: break
            self.blist.remove(c)
        if off:
            l = Gtk.Label(label='Bluetooth kapalı', margin_top=24, margin_bottom=24); l.add_css_class('cc-sub'); self.blist.append(l); return
        # adı MAC adresi olan (kimliği belirsiz) cihazları ele
        devs = [d for d in devs if not re.fullmatch(r'([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}', d['name'])]
        if not devs:
            l = Gtk.Label(label='Cihaz bulunamadı', margin_top=24, margin_bottom=24); l.add_css_class('cc-sub'); self.blist.append(l); return
        theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
        for d in sorted(devs, key=lambda d: (not d['connected'], not d['paired'], d['name'].lower())):
            b = Gtk.Button(); b.add_css_class('cc-row'); b.set_focusable(False)
            h = Gtk.Box(spacing=10, margin_start=4, margin_end=4)
            ic = d['icon'] + '-symbolic' if d['icon'] else ''
            if not ic or not theme.has_icon(ic): ic = 'bluetooth-symbolic'
            img = Gtk.Image.new_from_icon_name(ic); img.set_pixel_size(18); h.append(img)
            lab = Gtk.Label(label=d['name'], xalign=0, hexpand=True, ellipsize=3); lab.add_css_class('cc-title'); h.append(lab)
            st = 'Bağlı' if d['connected'] else ('Kayıtlı' if d['paired'] else '')
            if st:
                sl = Gtk.Label(label=st); sl.add_css_class('cc-sub'); h.append(sl)
            b.set_child(h)
            b.connect('clicked', lambda _b, dd=d: self.bt_action(dd))
            self.blist.append(b)

    def bt_action(self, d):
        self.bspin.start(); mac = d['mac']
        def work():
            if d['connected']: return sh(f'bluetoothctl disconnect {mac}', 15)
            if not d['paired']: sh(f'bluetoothctl pair {mac}', 25); sh(f'bluetoothctl trust {mac}', 5)
            return sh(f'bluetoothctl connect {mac}', 20)
        bg(work, lambda _o: (self.bspin.stop(), self.refresh_bt_list()))

    # ── eylemler ──
    def wifi_toggle(self):
        self.st['wifi'] = not self.st['wifi']; self._on(self.wc, self.st['wifi']); self.ws.set_text('Açılıyor…' if self.st['wifi'] else 'Kapalı')
        on = self.st['wifi']
        bg(lambda: (sh(f'nmcli radio wifi {"on" if on else "off"}'), time.sleep(2.5), sh("LC_ALL=C nmcli -t -f ACTIVE,SSID dev wifi list --rescan no | grep '^yes' | head -1 | cut -d: -f2"))[2],
           lambda v: self.ws.set_text(v or ('Bağlı değil' if self.st['wifi'] else 'Kapalı')))

    def bt_toggle(self):
        self.st['bt'] = not self.st['bt']; self._on(self.bc, self.st['bt']); self.bs.set_text('Açık' if self.st['bt'] else 'Kapalı')
        bg_run(f'{"rfkill unblock bluetooth; " if self.st["bt"] else ""}bluetoothctl power {"on" if self.st["bt"] else "off"}')

    def prof_cycle(self):
        i = (self.st['prof'] + 1) % 3; self.st['prof'] = i; self.ps.set_text(self.pnames[i]); self._on(self.pc, i != 1)
        self.pc.get_first_child().set_from_icon_name(self.picons[i]); bg_run(f'powerprofilesctl set {self.profs[i]}')

    def dnd_toggle(self):
        self.st['dnd'] = not self.st['dnd']; self._on(self.dc, self.st['dnd']); bg_run(f'swaync-client -{"dn" if self.st["dnd"] else "df"}')

    @staticmethod
    def _on(w, on):
        (w.add_css_class if on else w.remove_css_class)('on')

    # ── durumu güncelle (panel gösterilirken arka planda gelir) ──
    def apply_state(self, D):
        self._upd = True
        try:
            wifi = D['wifi'] == 'enabled'; self.st['wifi'] = wifi; self._on(self.wc, wifi)
            self.ws.set_text(D['ssid'] or ('Bağlı değil' if wifi else 'Kapalı'))
            bt = 'Powered: yes' in D['bt']; self.st['bt'] = bt; self._on(self.bc, bt); self.bs.set_text('Açık' if bt else 'Kapalı')
            cur = D['prof'] if D['prof'] in self.profs else 'balanced'; i = self.profs.index(cur); self.st['prof'] = i
            self.ps.set_text(self.pnames[i]); self._on(self.pc, i != 1); self.pc.get_first_child().set_from_icon_name(self.picons[i])
            dnd = D['dnd'] == 'true'; self.st['dnd'] = dnd; self._on(self.dc, dnd)
            self._on(self.dark_tile, S['dark'])
            try: self.br_scale.set_value(int(D['br'].strip('%') or 100))
            except Exception: pass
            m = re.search(r'([0-9.]+)', D['vol']); self.vol_scale.set_value(float(m.group(1)) * 100 if m else 0)
            self.fill_np(D)
        finally:
            self._upd = False

    def fill_np(self, D):
        while True:
            c = self.np_box.get_first_child()
            if c is None: break
            self.np_box.remove(c)
        title, artist = D['title'], D['artist']
        self.np_box.set_visible(bool(title))
        if not title: return
        np_ = Gtk.Box(spacing=12); np_.add_css_class('cc-card')
        art = D['art']
        if art.startswith('file://') and os.path.exists(art[7:]):
            pic = Gtk.Picture.new_for_filename(art[7:]); pic.set_content_fit(Gtk.ContentFit.COVER)
        else:
            pic = Gtk.Image.new_from_icon_name('audio-x-generic-symbolic'); pic.set_pixel_size(28)
        pic.set_size_request(42, 42); pic.add_css_class('cc-art'); np_.append(pic)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER, hexpand=True)
        tl = Gtk.Label(label=title, xalign=0, ellipsize=3, max_width_chars=18); tl.add_css_class('cc-title'); v.append(tl)
        al = Gtk.Label(label=artist, xalign=0, ellipsize=3, max_width_chars=22); al.add_css_class('cc-sub'); v.append(al)
        np_.append(v)
        playing = D['pstat'] == 'Playing'
        pp = Gtk.Button(icon_name='media-playback-pause-symbolic' if playing else 'media-playback-start-symbolic'); pp.add_css_class('cc-media'); pp.set_focusable(False)
        def toggle_pp():
            bg_run('playerctl play-pause'); pp.set_icon_name('media-playback-start-symbolic' if pp.get_icon_name() == 'media-playback-pause-symbolic' else 'media-playback-pause-symbolic')
        pp.connect('clicked', lambda *_: toggle_pp())
        nx = Gtk.Button(icon_name='media-skip-forward-symbolic'); nx.add_css_class('cc-media'); nx.set_focusable(False)
        nx.connect('clicked', lambda *_: bg_run('playerctl next'))
        np_.append(pp); np_.append(nx); self.np_box.append(np_)


class CCDaemon:
    """Arka planda hazır bekleyen Denetim Merkezi: çubuktan gelen SIGUSR1 ile anında gösterilir/gizlenir."""
    def __init__(self, app):
        self.app = app; self.panels = {}; self.catchers = {}; self.label = 'control'; self.opened = 0.0
        self._css = None; self.css_key = None; self._wall = {}; self._gfiles = {}; self._gseq = 0
        self._gprov = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self._gprov, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        self.refresh_css(force=True)
        D = fetch_state()
        mons = Gdk.Display.get_default().get_monitors()
        for i in range(mons.get_n_items()):
            m = mons.get_item(i); name = m.get_connector()
            self.panels[name] = ControlCenter(app, self, m, D)
            self.panels[name].idx = i; self.panels[name].gmon = m; self.panels[name].root.add_css_class(f'cc-m{i}')
            if LS_OK: self.catchers[name] = self.make_catcher(m)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_usr1)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (app.quit(), False)[1])
        try: open(CC_PID, 'w').write(str(os.getpid()))
        except Exception: pass
        import atexit
        atexit.register(lambda: os.path.exists(CC_PID) and open(CC_PID).read().strip() == str(os.getpid()) and os.remove(CC_PID))

    def make_catcher(self, m):
        LS = Gtk4LayerShell
        w = Gtk.Window(application=self.app, decorated=False); w.add_css_class('tahoe-catcher')
        LS.init_for_window(w); LS.set_namespace(w, 'tahoe-cc-catcher'); LS.set_layer(w, LS.Layer.TOP); LS.set_monitor(w, m)
        for e in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT): LS.set_anchor(w, e, True)
        LS.set_margin(w, LS.Edge.TOP, 37); LS.set_exclusive_zone(w, -1)
        g = Gtk.GestureClick(); g.connect('pressed', lambda *_: self.hide()); w.add_controller(g)
        bx = Gtk.Box(); bx.set_size_request(10, 10); w.set_child(bx)
        return w

    def refresh_css(self, force=False):
        """Ayarlar başka süreçte değişmiş olabilir (koyu mod/vurgu): panel göstermeden önce CSS'i tazele."""
        fresh = load()
        key = (fresh['dark'], fresh['accent'])
        if not force and key == self.css_key: return
        S['dark'], S['accent'] = key; self.css_key = key
        disp = Gdk.Display.get_default()
        if self._css is not None: Gtk.StyleContext.remove_provider_for_display(disp, self._css)
        self._css = Gtk.CssProvider(); self._css.load_from_data(cc_css())
        Gtk.StyleContext.add_provider_for_display(disp, self._css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK if key[0] else Adw.ColorScheme.FORCE_LIGHT)

    # ── cam efekti: duvar kağıdının bulanık kopyası + ton (Hyprland katman bulanıklığı bu kurulumda çalışmıyor) ──
    def wall_blur(self, mw, mh):
        path = f'{HYPR}/wallpaper.png'
        try: mt = os.path.getmtime(path)
        except Exception: return None
        key = (mw, mh, mt, S['dark'])
        if self._wall.get((mw, mh, 'k')) == key: return self._wall[(mw, mh)]
        from PIL import Image, ImageFilter, ImageEnhance
        im = Image.open(path).convert('RGB'); iw, ih = im.size; sc = max(mw / iw, mh / ih)
        im = im.resize((int(iw * sc) + 1, int(ih * sc) + 1), Image.BILINEAR)
        ox, oy = (im.width - mw) // 2, (im.height - mh) // 2
        im = im.crop((ox, oy, ox + mw, oy + mh)).filter(ImageFilter.GaussianBlur(26))
        im = ImageEnhance.Color(im).enhance(1.7)
        self._wall[(mw, mh)] = im; self._wall[(mw, mh, 'k')] = key
        return im

    def update_glass(self, panel, bar_h):
        try:
            g = panel.gmon.get_geometry(); mw, mh = g.width, g.height
            im = self.wall_blur(mw, mh)
            if im is None: return
            W, H = 360, 520
            x1 = mw - 8; y0 = bar_h + 6
            crop = im.crop((x1 - W, y0, x1, min(mh, y0 + H)))
            self._gseq += 1
            rt = os.environ.get('XDG_RUNTIME_DIR', '/tmp')
            fn = f'{rt}/tahoe-cc-bg-{panel.idx}-{self._gseq}.png'
            crop.save(fn)
            old = self._gfiles.get(panel.idx)
            self._gfiles[panel.idx] = fn
            if old and os.path.exists(old): os.remove(old)
            tint = 'rgba(18,18,26,0.40)' if S['dark'] else 'rgba(255,255,255,0.42)'
            rules = ''.join(f'.tahoe-cc-box.cc-m{i} {{ background-image: linear-gradient({tint}, {tint}), url("file://{f}"); background-position: 0 0, right top; background-repeat: no-repeat, no-repeat; background-size: 100% 100%, auto; }}\n' for i, f in self._gfiles.items())
            self._gprov.load_from_data(rules.encode())
        except Exception as e:
            print('cam arka plan hatası:', e, file=sys.stderr)

    def focused(self):
        try:
            mons = json.loads(sh('hyprctl monitors -j', 2))
            foc = next((m for m in mons if m.get('focused')), mons[0])
            return foc['name'], int(foc['reserved'][1])
        except Exception:
            return None, 37

    def visible(self): return any(p.get_visible() for p in self.panels.values())

    def on_usr1(self):
        try: label = open(CC_REQ).read().strip() or 'control'
        except Exception: label = 'control'
        if self.visible():
            if label == self.label and time.time() - self.opened > 0.3: self.hide()
            else: self.label = label
        else:
            self.show(label)
        return True

    def show(self, label):
        name, bar_h = self.focused()
        panel = self.panels.get(name) or next(iter(self.panels.values()))
        self.refresh_css()
        if LS_OK:
            for c in self.catchers.values():
                Gtk4LayerShell.set_margin(c, Gtk4LayerShell.Edge.TOP, bar_h); c.present()
        self.update_glass(panel, bar_h)
        panel.reset_view(); panel.present(); self.label = label; self.opened = time.time()
        bg(fetch_state, lambda D: panel.apply_state(D) if (D and panel.get_visible()) else None)

    def hide(self):
        for w in list(self.panels.values()) + list(self.catchers.values()): w.set_visible(False)

APP = None
CC_LABEL = ['control']
CC_REQ = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'tahoe-cc.req')
CC_PID = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'tahoe-cc.pid')

class TahoeApp(Adw.Application):
    def __init__(self, mode, pane):
        flags = Gio.ApplicationFlags.NON_UNIQUE if mode == 'ccd' else Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        super().__init__(application_id='org.tahoe.ControlCenter' if mode == 'ccd' else 'org.tahoe.Settings', flags=flags)
        self.mode, self.pane = mode, pane

    def do_command_line(self, cl):
        # Sistem Ayarları tek örnekli: açıksa yeni pencere açmak yerine bölümü değiştirir
        args = cl.get_arguments()
        pane = args[args.index('--pane') + 1] if '--pane' in args else None
        win = self.props.active_window
        if win is not None and isinstance(win, SettingsWindow):
            if pane: win.show_pane(pane)
            win.present()
        else:
            self.pane = pane
            self.activate()
        return 0

    def do_activate(self):
        if self.mode == 'ccd':
            if getattr(self, 'daemon', None) is None:
                Gtk.Settings.get_default().set_property('gtk-icon-theme-name', 'Adwaita')
                self.hold(); self.daemon = CCDaemon(self)
                if getattr(self, 'show_on_start', False): self.daemon.show(CC_LABEL[0])
            return
        win = self.props.active_window
        if win is not None:
            win.present(); return
        Gtk.Settings.get_default().set_property('gtk-icon-theme-name', 'Adwaita')
        pv = Gtk.CssProvider(); pv.load_from_data(b'row.tahoe-sep, row.tahoe-sep:hover { background: transparent; min-height: 0; padding: 0; margin: 0; }')
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), pv, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        pt = Gtk.CssProvider(); pt.load_from_data(TL_CSS + cc_css())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), pt, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK if S['dark'] else Adw.ColorScheme.FORCE_LIGHT)
        w = SettingsWindow(self, self.pane)
        w.present()

def default_wallpaper():
    os.makedirs(f'{HOME}/.local/share/tahoe/walls', exist_ok=True)
    for name, a, b, c in WALLS:
        p = f'{HOME}/.local/share/tahoe/walls/{name}.png'
        if not os.path.exists(p): make_wall(a, b, c, p)
    dst = f'{HYPR}/wallpaper.png'
    if not os.path.exists(dst): shutil.copy(f'{HOME}/.local/share/tahoe/walls/{WALLS[0][0]}.png', dst)

def main():
    global APP
    args = sys.argv[1:]
    if '--default-wallpaper' in args:
        default_wallpaper(); return
    if '--apply' in args:          # tüm ayarları (tema, hyprland, dock, saat, kilit) yeniden üret
        apply_theme(); apply_hypr(); write_clock(); write_idle(); return
    if '--apply-theme' in args:
        apply_theme(); return
    if '--control-center' in args:
        # Eski kullanım: çubuk betiği (tahoe-cc) daemon'a sinyal gönderir; burada ona devret
        lab = args[args.index('--from') + 1] if '--from' in args else 'control'
        os.execvp('tahoe-cc', ['tahoe-cc', lab])
    mode = 'ccd' if '--control-center-daemon' in args else 'settings'
    if mode == 'ccd':
        CC_LABEL[0] = args[args.index('--from') + 1] if '--from' in args else 'control'
        # Zaten çalışan bir daemon varsa yalnızca göster/gizle isteği gönder
        try:
            pid = int(open(CC_PID).read().strip())
            if b'control-center-daemon' in open(f'/proc/{pid}/cmdline', 'rb').read():
                if '--show' in args:
                    try: open(CC_REQ, 'w').write(CC_LABEL[0])
                    except Exception: pass
                    os.kill(pid, signal.SIGUSR1)
                return
        except Exception: pass
    pane = args[args.index('--pane') + 1] if '--pane' in args else None
    APP = TahoeApp(mode, pane)
    APP.show_on_start = '--show' in args
    APP.run([sys.argv[0]] if mode == 'ccd' else sys.argv)

if __name__ == '__main__':
    main()
