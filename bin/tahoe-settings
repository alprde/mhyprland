def wp_get(target):
    out = sh(f'wpctl get-volume {target}')
    m = re.search(r'([0-9.]+)', out)
    return (float(m.group(1)) * 100 if m else 0), 'MUTED' in out

def pane_sound():
    g = grp('Çıkış'); sinks = []
    try: sinks = json.loads(sh('pactl --format=json list sinks'))
    except Exception: pass
    names = [s.get('description', s['name']) for s in sinks]; ids = [s['name'] for s in sinks]
    cur = sh('pactl get-default-sink')
    if sinks: g.add(r_combo('Çıkış aygıtı', names, ids.index(cur) if cur in ids else 0, lambda i: bg_run(f'pactl set-default-sink {ids[i]}')))
    v, mu = wp_get('@DEFAULT_AUDIO_SINK@')
    g.add(r_scale('Çıkış ses düzeyi', 0, 100, 1, v, lambda x: bg_run(f'wpctl set-volume @DEFAULT_AUDIO_SINK@ {int(x)}%'), unit='%'))
    g.add(r_switch('Sessiz', mu, lambda x: bg_run(f'wpctl set-mute @DEFAULT_AUDIO_SINK@ {1 if x else 0}')))
    g2 = grp('Giriş'); srcs = []
    try: srcs = [s for s in json.loads(sh('pactl --format=json list sources')) if '.monitor' not in s['name']]
    except Exception: pass
    if srcs:
        sn = [s.get('description', s['name']) for s in srcs]; si = [s['name'] for s in srcs]; cs = sh('pactl get-default-source')
        g2.add(r_combo('Giriş aygıtı', sn, si.index(cs) if cs in si else 0, lambda i: bg_run(f'pactl set-default-source {si[i]}')))
    v2, mu2 = wp_get('@DEFAULT_AUDIO_SOURCE@')
    g2.add(r_scale('Giriş ses düzeyi', 0, 100, 1, v2, lambda x: bg_run(f'wpctl set-volume @DEFAULT_AUDIO_SOURCE@ {int(x)}%'), unit='%'))
    g2.add(r_switch('Mikrofonu sustur', mu2, lambda x: bg_run(f'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ {1 if x else 0}')))
    g3 = grp(); g3.add(r_button('Gelişmiş ses ayarları', 'Aç…', lambda: bg_run('pavucontrol')))
    return new_page(g, g2, g3)

def pane_lock():
    g = grp('Ekran Kilidi ve Güç Tasarrufu', 'Süreler saniye cinsindendir. 0 = kapalı.')
    t = S['idle']
    def mk(key, title):
        g.add(r_spin(title, 0, 7200, 30, t[key], lambda v, k=key: (t.__setitem__(k, int(v)), schedule_idle())))
    mk('lock', 'Boşta kalınca ekranı kilitle'); mk('dpms', 'Ekranı kapat'); mk('suspend', 'Uyku moduna geç')
    g2 = grp(); g2.add(r_button('Ekranı şimdi kilitle', 'Kilitle', lambda: bg_run('hyprlock')))
    return new_page(g, g2)

_it = None
def schedule_idle():
    global _it
    if _it: GLib.source_remove(_it)
    def go():
        global _it; _it = None; threading.Thread(target=write_idle, daemon=True).start(); return False
    _it = GLib.timeout_add(900, go)

def pane_privacy():
    g = grp('Güvenlik')
    fw = sh('systemctl is-active ufw')
    g.add(r_info('Güvenlik duvarı (ufw)', 'Etkin' if fw == 'active' else 'Kapalı'))
    g.add(r_button('Güvenlik duvarını aç/kapat', 'Değiştir', lambda: bg_run('pkexec sh -c "systemctl is-active ufw && (ufw disable; systemctl disable --now ufw) || (systemctl enable --now ufw; ufw enable)"')))
    g.add(r_info('Disk şifreleme', 'LUKS' if 'crypt' in sh('lsblk -o TYPE') else 'Yok'))
    g2 = grp('Gizlilik')
    g2.add(r_button('Pano geçmişini temizle', 'Temizle', lambda: bg_run('cliphist wipe 2>/dev/null; wl-copy --clear')))
    g2.add(r_info('Ekran paylaşımı', 'xdg-desktop-portal-hyprland ile izin istenir'))
    return new_page(g, g2)

def pane_login():
    g = grp('Oturum açılınca aç')
    files = sorted(glob.glob(f'{HOME}/.config/autostart/*.desktop'))
    if not files: g.add(r_info('Öğe yok', 'Eklemek için + kullanın'))
    for f in files:
        nm = os.path.basename(f)[:-8]
        txt = open(f, errors='ignore').read()
        m = re.search(r'^Name=(.*)$', txt, re.M)
        r = Adw.ActionRow(title=m.group(1) if m else nm, subtitle=os.path.basename(f))
        b = Gtk.Button(icon_name='user-trash-symbolic', valign=Gtk.Align.CENTER, css_classes=['flat'])
        b.connect('clicked', lambda _b, f=f, r=r: (os.remove(f), g.remove(r))); r.add_suffix(b); g.add(r)
    g2 = grp(); e = Adw.EntryRow(title='Komut (ör. discord)'); g2.add(e)
    def add():
        c = e.get_text().strip()
        if not c: return
        os.makedirs(f'{HOME}/.config/autostart', exist_ok=True)
        n = re.sub(r'\W+', '-', c)[:40]
        open(f'{HOME}/.config/autostart/{n}.desktop', 'w').write(f'[Desktop Entry]\nType=Application\nName={c}\nExec={c}\n')
        toast('Eklendi'); e.set_text('')
    g2.add(r_button('Giriş öğesi ekle', 'Ekle', add))
    return new_page(g, g2)

def pane_users():
    g = grp('Kullanıcı'); u = os.environ.get('USER', '')
    for t, v in [('Ad', sh(f"getent passwd {u} | cut -d: -f5 | cut -d, -f1") or u), ('Hesap', u), ('UID', str(os.getuid())),
                 ('Ana dizin', HOME), ('Kabuk', sh(f"getent passwd {u} | cut -d: -f7")), ('Gruplar', sh('id -Gn').replace(' ', ', '))]:
        g.add(r_info(t, v))
    g2 = grp(); g2.add(r_button('Parolayı değiştir', 'Değiştir…', lambda: bg_run("kitty -e passwd")))
    return new_page(g, g2)

