    g.add(r_spin('Tekrarlamaya kadar gecikme (ms)', 150, 1500, 50, i['repeat_delay'], lambda v: (i.__setitem__('repeat_delay', int(v)), schedule_apply())))
    g2 = grp('Klavye Kısayolları')
    for k, d in [('⌘ Enter', 'Terminal'), ('⌘ Space / ⌘ D', 'Spotlight'), ('⌘ Q', 'Pencereyi kapat'), ('⌘ Tab', 'Pencere değiştirici'), ('⌘ Ctrl Q', 'Ekranı kilitle'),
