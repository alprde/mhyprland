TL_CSS = b"""
.tl-box { margin: 0 4px 0 8px; }
button.tl { min-width: 12px; min-height: 12px; padding: 0; margin: 0; border-radius: 999px; box-shadow: none; background-image: none;
            border: 1px solid rgba(0,0,0,0.14); }
button.tl label { font-size: 9px; font-weight: 800; color: rgba(0,0,0,0.55); opacity: 0; }
.tl-box:hover button.tl label { opacity: 1; }
button.tl-close { background-color: #ff5f57; } button.tl-close:hover { background-color: #ff5f57; }
button.tl-min   { background-color: #febc2e; } button.tl-min:hover   { background-color: #febc2e; }
button.tl-max   { background-color: #28c840; } button.tl-max:hover   { background-color: #28c840; }
window:backdrop button.tl { background-color: rgba(128,128,136,0.45); }
"""

def traffic_lights(win):
    box = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER); box.add_css_class('tl-box')
    def mk(cls, glyph, cb):
        b = Gtk.Button(); b.add_css_class('tl'); b.add_css_class(cls); b.set_focusable(False)
        b.set_child(Gtk.Label(label=glyph)); b.connect('clicked', lambda *_: cb()); box.append(b)
    mk('tl-close', '×', win.close)
    mk('tl-min', '−', lambda: sh("hyprctl dispatch 'hl.dsp.window.move({ workspace = \"special:minimized\" })'"))
    mk('tl-max', '+', lambda: sh("hyprctl dispatch 'hl.dsp.window.fullscreen()'"))
    return box

def no_native_controls(*bars):
    for b in bars:
        b.set_show_start_title_buttons(False); b.set_show_end_title_buttons(False)

# ───────────────────────── Sistem Ayarları penceresi ─────────────────────────
class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app, pane=None):
        super().__init__(application=app, title='Sistem Ayarları', default_width=1000, default_height=700)
        self.toasts = Adw.ToastOverlay()
        self.split = Adw.NavigationSplitView(); self.split.set_min_sidebar_width(250); self.split.set_max_sidebar_width(300)
        self.toasts.set_child(self.split); self.set_content(self.toasts)
        sb = Adw.ToolbarView(); sh_ = Adw.HeaderBar(); sh_.set_show_title(False); sb.add_top_bar(sh_)
        no_native_controls(sh_); sh_.pack_start(traffic_lights(self))
        self.search = Gtk.SearchEntry(placeholder_text='Ara', margin_start=10, margin_end=10, margin_bottom=6)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); box.append(self.search)
        self.lb = Gtk.ListBox(css_classes=['navigation-sidebar']); self.lb.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.idx = []
        for p in PANES:
            if p is None:
                r = Gtk.ListBoxRow(selectable=False, activatable=False, height_request=14); r.add_css_class('tahoe-sep'); r.sep = True; r.name = ''; self.lb.append(r); self.idx.append(None); continue
            key, name, icon, fn = p
            r = Gtk.ListBoxRow(); r.sep = False; r.key = key; r.name = name
            h = Gtk.Box(spacing=12, margin_top=7, margin_bottom=7, margin_start=8, margin_end=8)
            h.append(Gtk.Image.new_from_icon_name(icon)); h.append(Gtk.Label(label=name, xalign=0)); r.set_child(h)
            self.lb.append(r); self.idx.append(p)
        sc = Gtk.ScrolledWindow(vexpand=True); sc.set_child(self.lb); box.append(sc); sb.set_content(box)
        self.split.set_sidebar(Adw.NavigationPage.new(sb, 'Sistem Ayarları'))
        self.ctb = Adw.ToolbarView(); self.chead = Adw.HeaderBar(); self.ctitle = Adw.WindowTitle(title='', subtitle=''); self.chead.set_title_widget(self.ctitle)
        no_native_controls(self.chead)
        self.ctb.add_top_bar(self.chead)
        self.cpage = Adw.NavigationPage.new(self.ctb, 'Ayarlar'); self.split.set_content(self.cpage)
        self.lb.connect('row-selected', self.on_row)
        self.search.connect('search-changed', lambda e: self.lb.invalidate_filter())
        self.lb.set_filter_func(self.filt)
        self.show_pane(pane or 'wifi')

    def filt(self, row):
        q = self.search.get_text().lower().strip()
        if not q: return True
        return (not row.sep) and q in row.name.lower()

    def on_row(self, lb, row):
        if row is None or row.sep: return
        self.build(row.key)

    def build(self, key):
        for p in PANES:
            if p and p[0] == key:
                self.ctitle.set_title(p[1]); self.cpage.set_title(p[1])
                try: w = p[3]()
                except Exception as e:
                    w = Adw.StatusPage(title='Bu bölüm açılamadı', description=str(e))
                self.ctb.set_content(w); self.split.set_show_content(True); return

    def show_pane(self, key):
        for i, p in enumerate(PANES):
            if p and p[0] == key:
                self.lb.select_row(self.lb.get_row_at_index(i)); return

# ───────────────────────── Denetim Merkezi ─────────────────────────
class ControlCenter(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='Denetim Merkezi', default_width=360, default_height=520, decorated=False, resizable=False)
        self.add_css_class('tahoe-cc')
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=14, margin_bottom=14, margin_start=14, margin_end=14)
        grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True)
        wifi = sh('nmcli radio wifi') == 'enabled'; bt = 'Powered: yes' in sh('bluetoothctl show')
        dnd = sh('swaync-client -D') == 'true'
        self.tiles = []
        def tile(icon, label, active, cb, col, row):
            b = Gtk.ToggleButton(); b.set_active(active)
            bx = Gtk.Box(spacing=10, margin_top=10, margin_bottom=10, margin_start=6, margin_end=6)
            bx.append(Gtk.Image.new_from_icon_name(icon)); bx.append(Gtk.Label(label=label, xalign=0, hexpand=True)); b.set_child(bx)
            b.connect('toggled', lambda w: cb(w.get_active())); grid.attach(b, col, row, 1, 1)
            return b
        tile('network-wireless-symbolic', 'Wi-Fi', wifi, lambda v: bg_run(f'nmcli radio wifi {"on" if v else "off"}'), 0, 0)
        tile('bluetooth-symbolic', 'Bluetooth', bt, lambda v: bg_run(f'{"rfkill unblock bluetooth; " if v else ""}bluetoothctl power {"on" if v else "off"}'), 1, 0)
        tile('weather-clear-night-symbolic', 'Koyu Mod', S['dark'], lambda v: (S.__setitem__('dark', v), save(), bg(apply_theme)), 0, 1)
        tile('notifications-disabled-symbolic', 'Rahatsız Etme', dnd, lambda v: bg_run(f'swaync-client -{"dn" if v else "df"}'), 1, 1)
        outer.append(grid)
        def slider(icon, label, val, cb):
            f = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, css_classes=['card'], margin_top=0)
            f.set_margin_top(2)
            l = Gtk.Label(label=label, xalign=0, margin_start=12, margin_top=8, css_classes=['heading'])
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1); sc.set_value(val); sc.set_margin_start(12); sc.set_margin_end(12); sc.set_margin_bottom(10)
            sc.connect('value-changed', lambda w: cb(w.get_value())); f.append(l); f.append(sc); outer.append(f)
        try: br = int(sh('brightnessctl -m | cut -d, -f4').strip('%') or 100)
        except Exception: br = 100
        slider('', 'Ekran', br, lambda v: bg_run(f'brightnessctl set {max(1,int(v))}%'))
        slider('', 'Ses', wp_get('@DEFAULT_AUDIO_SINK@')[0], lambda v: bg_run(f'wpctl set-volume @DEFAULT_AUDIO_SINK@ {int(v)}%'))
        # Güç modu
        prof = ['power-saver', 'balanced', 'performance']; cur = sh('powerprofilesctl get') or 'balanced'
        pf = Gtk.Box(spacing=6, homogeneous=True)
        first = None
        for p, n in zip(prof, ['Tasarruf', 'Dengeli', 'Performans']):
            b = Gtk.ToggleButton(label=n)
            if first: b.set_group(first)
            else: first = b
            b.set_active(p == cur); b.connect('toggled', lambda w, p=p: w.get_active() and bg_run(f'powerprofilesctl set {p}')); pf.append(b)
        outer.append(Gtk.Label(label='Güç modu', xalign=0, css_classes=['heading'])); outer.append(pf)
        # Şimdi çalıyor
        title = sh('playerctl metadata title 2>/dev/null'); artist = sh('playerctl metadata artist 2>/dev/null')
        if title:
            np_ = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, css_classes=['card'])
            np_.append(Gtk.Label(label=title, xalign=0, margin_start=12, margin_top=8, ellipsize=3, css_classes=['heading']))
            np_.append(Gtk.Label(label=artist, xalign=0, margin_start=12, ellipsize=3, css_classes=['dim-label']))
            cb_ = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, margin_bottom=8)
            for ic, cmd in [('media-skip-backward-symbolic', 'previous'), ('media-playback-start-symbolic', 'play-pause'), ('media-skip-forward-symbolic', 'next')]:
                b = Gtk.Button(icon_name=ic, css_classes=['flat']); b.connect('clicked', lambda _b, c=cmd: bg_run(f'playerctl {c}')); cb_.append(b)
            np_.append(cb_); outer.append(np_)
        btn = Gtk.Button(label='Sistem Ayarları…'); btn.connect('clicked', lambda *_: (bg_run('tahoe-settings'), app.quit()))
        outer.append(btn)
        self.set_content(outer)
        self.connect('notify::is-active', self.on_active)
        self._armed = False
        GLib.timeout_add(600, lambda: (setattr(self, '_armed', True), False)[1])

    def on_active(self, w, _):
        if self._armed and not self.is_active():
            APP.quit()

APP = None

class TahoeApp(Adw.Application):
    def __init__(self, mode, pane):
        super().__init__(application_id='org.tahoe.ControlCenter' if mode == 'cc' else 'org.tahoe.Settings', flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.mode, self.pane = mode, pane

    def do_activate(self):
        Gtk.Settings.get_default().set_property('gtk-icon-theme-name', 'Adwaita')
        pv = Gtk.CssProvider(); pv.load_from_data(b'row.tahoe-sep, row.tahoe-sep:hover { background: transparent; min-height: 0; padding: 0; margin: 0; }')
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), pv, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        pt = Gtk.CssProvider(); pt.load_from_data(TL_CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), pt, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK if S['dark'] else Adw.ColorScheme.FORCE_LIGHT)
        w = ControlCenter(self) if self.mode == 'cc' else SettingsWindow(self, self.pane)
        w.present()

def default_wallpaper():
    os.makedirs(f'{HOME}/.local/share/tahoe/walls', exist_ok=True)
    for name, a, b, c in WALLS:
        p = f'{HOME}/.local/share/tahoe/walls/{name}.png'
        if not os.path.exists(p): make_wall(a, b, c, p)
    dst = f'{HYPR}/wallpaper.png'
    if not os.path.exists(dst): shutil.copy(f'{HOME}/.local/share/tahoe/walls/{WALLS[0][0]}.png', dst)

def main():
    global APP
    args = sys.argv[1:]
    if '--default-wallpaper' in args:
        default_wallpaper(); return
    if '--apply' in args:          # tüm ayarları (tema, hyprland, dock, saat, kilit) yeniden üret
        apply_theme(); apply_hypr(); write_clock(); write_idle(); return
    if '--apply-theme' in args:
        apply_theme(); return
    mode = 'cc' if '--control-center' in args else 'settings'
    if mode == 'cc':
        me = os.getpid()
        others = []
        for d in os.listdir('/proc'):
            if not d.isdigit() or int(d) == me: continue
            try: argv = open(f'/proc/{d}/cmdline', 'rb').read().split(b'\0')
            except Exception: continue
            if len(argv) > 2 and os.path.basename(argv[0].decode(errors='ignore')).startswith('python') and argv[1].decode(errors='ignore').endswith('tahoe-settings') and b'--control-center' in argv:
                others.append(int(d))
        if others:
            for p in others:
                try: os.kill(p, 15)
                except Exception: pass
            return
    pane = args[args.index('--pane') + 1] if '--pane' in args else None
    APP = TahoeApp(mode, pane)
    APP.run([sys.argv[0]])

if __name__ == '__main__':
    main()
