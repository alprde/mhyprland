    g.add(r_button('Yazıcı ekle / yönet', 'Aç…', lambda: bg_run('system-config-printer'), 'Yazıcılar ve tarayıcılar'))
    g.add(r_button('Yazdırma servisini başlat', 'Başlat', lambda: bg_run('pkexec systemctl enable --now cups')))
    return new_page(g)

def pane_datetime():
    g = grp('Tarih ve Saat')
    ntp = sh('timedatectl show -p NTP --value') == 'yes'
    g.add(r_switch('Tarih ve saati otomatik ayarla', ntp, lambda v: bg_run(f'pkexec timedatectl set-ntp {"true" if v else "false"}')))
    zones = sh('timedatectl list-timezones').split('\n'); cur = sh('timedatectl show -p Timezone --value')
    row = r_combo('Saat dilimi', zones, zones.index(cur) if cur in zones else 0, lambda i: bg_run(f'pkexec timedatectl set-timezone {zones[i]}'))
    row.set_enable_search(True); g.add(row)
    g.add(r_info('Şu an', sh('date "+%A %e %B %Y, %H:%M:%S"')))
    g2 = grp('Menü çubuğunda saat'); c = S['clock']
    g2.add(r_switch('24 saatlik biçim', c['h24'], lambda v: (c.__setitem__('h24', v), write_clock())))
    g2.add(r_switch('Saniyeyi göster', c['seconds'], lambda v: (c.__setitem__('seconds', v), write_clock())))
    g2.add(r_switch('Tarihi göster', c['date'], lambda v: (c.__setitem__('date', v), write_clock())))
    return new_page(g, g2)

def pane_lang():
    g = grp('Dil ve Bölge')
    cur = sh("localectl status | grep 'LANG=' | head -1 | sed 's/.*LANG=//'")
    locs = [l for l in sh('locale -a').split('\n') if 'utf8' in l.lower()]
    locs = [l.replace('.utf8', '.UTF-8') for l in locs]
    g.add(r_info('Geçerli dil', cur or os.environ.get('LANG', '')))
    if locs: g.add(r_combo('Sistem dili', locs, locs.index(cur) if cur in locs else 0, lambda i: bg_run(f'pkexec localectl set-locale LANG={locs[i]}'), 'Yeniden oturum açınca geçerli olur'))
    g.add(r_info('Klavye düzeni (konsol)', sh("localectl status | grep 'VC Keymap' | sed 's/.*: //'")))
    return new_page(g)

